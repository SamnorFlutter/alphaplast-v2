---
pagination:
  data: langs
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "/{{ lang }}/bestsellers/"
layout: base.njk
eleventyComputed:
  seoTitle: "{{ T.bestsellers.title }} — Alpha Plast"
  seoDesc: "{{ T.bestsellers.sub }}"
---
<section class="section page-head">
  <div class="container">
    {% set crumbs = [{ "name": T.nav.bestsellers, "url": L + "/bestsellers/" }] %}{% include "partials/breadcrumbs.njk" %}
    <h1>{{ T.bestsellers.title }}</h1>
    <p class="sub">{{ T.bestsellers.sub }}</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="grid grid-4 bs-grid">
      {% for b in bestsellers.items | where('active', true) | sortBy('order') %}{% include "partials/bestseller-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="glass cta-band">
      <div><h2>{{ T.catalog.custom_calc }}</h2><p class="muted">{{ T.calc.range_hint }}</p></div>
      <a class="btn btn-primary btn-lg" href="{{ (L + '/calculator/') | url }}">{{ T.cta.calc }} <svg class="ic"><use href="#i-arrow"/></svg></a>
    </div>
  </div>
</section>
