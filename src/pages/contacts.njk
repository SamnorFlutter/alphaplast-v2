---
pagination:
  data: langs
  size: 1
  alias: lang
  addAllPagesToCollections: true
permalink: "/{{ lang }}/contacts/"
layout: base.njk
eleventyComputed:
  seoTitle: "{{ pages.contacts.seo_title[lang] }}"
  seoDesc: "{{ pages.contacts.seo_desc[lang] }}"
---
<section class="section page-head">
  <div class="container">
    {% set crumbs = [{ "name": T.nav.contacts, "url": L + "/contacts/" }] %}{% include "partials/breadcrumbs.njk" %}
    <h1>{{ pages.contacts.h1 | tr(lang) }}</h1>
    <p class="sub">{{ pages.contacts.intro | tr(lang) }}</p>
  </div>
</section>
<section class="section">
  <div class="container grid grid-4 contact-cards">
    <div class="glass tile"><span class="tile-icon"><svg class="ic"><use href="#i-phone"/></svg></span><span class="tile-title">{{ T.common.phone }}</span>{% for ph in company.phones %}<a class="tile-link" href="tel:{{ company.phones_raw[loop.index0] }}" data-event="phone_click">{{ ph }}</a>{% endfor %}</div>
    <div class="glass tile"><span class="tile-icon"><svg class="ic"><use href="#i-tg"/></svg></span><span class="tile-title">Telegram · Email</span><a class="tile-link" href="{{ company.telegram }}" rel="noopener" data-event="tg_click">@alphaplastuz</a><a class="tile-link" href="{{ company.telegram_channel }}" rel="noopener">@alpha_plast</a><a class="tile-link" href="mailto:{{ company.email }}">{{ company.email }}</a></div>
    <div class="glass tile"><span class="tile-icon"><svg class="ic"><use href="#i-pin"/></svg></span><span class="tile-title">{{ T.common.address }}</span><span class="tile-desc">{{ company.address | tr(lang) }}</span><div class="map-btns"><a class="btn btn-glass btn-sm" href="{{ company.maps.yandex }}" rel="noopener" data-event="route_yandex">{{ T.common.map_yandex }}</a><a class="btn btn-glass btn-sm" href="{{ company.maps['2gis'] }}" rel="noopener" data-event="route_2gis">{{ T.common.map_2gis }}</a><a class="btn btn-glass btn-sm" href="{{ company.maps.google }}" rel="noopener" data-event="route_google">{{ T.common.map_google }}</a></div></div>
    <div class="glass tile"><span class="tile-icon"><svg class="ic"><use href="#i-clock"/></svg></span><span class="tile-title">{{ T.common.hours }}</span><span class="tile-desc">{{ company.hours | tr(lang) }}</span><a class="tile-link" href="{{ '/contact.vcf' | url }}" download data-event="vcard_save">{{ T.cta.save_contact }} →</a></div>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="glass map-wrap" data-map="{{ cfg.yandex_map_widget }}">
      <button type="button" class="btn btn-glass" data-map-load><svg class="ic"><use href="#i-map"/></svg>{{ T.common.load_map }}</button>
    </div>
  </div>
</section>
<section class="section">
  <div class="container contact-grid">
    {% set formId = 'lead-contacts' %}{% set presetSpec = '' %}{% set presetProduct = '' %}{% include "partials/lead-form.njk" %}
    <div class="glass tile">
      <span class="tile-title">{{ T.footer.requisites }}</span>
      <table class="table"><tbody>{% for r in company.requisites %}<tr><th>{{ r.label | tr(lang) }}</th><td>{% if r.todo %}<span class="muted">{{ T.footer.todo }}</span>{% else %}{{ r.value | tr(lang) }}{% endif %}</td></tr>{% endfor %}</tbody></table>
    </div>
  </div>
</section>
